{
  "name": "la-gueuze",
  "version": "3.0.0",
  "private": true,
  "description": "LA GUEUZE — Tout le tournage. Dans ta poche.",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "reporter.hipo.lagueuze",
    "productName": "LA GUEUZE",
    "files": [
      "app.js",
      "assets/**/*",
      "config/**/*",
      "desktop/**/*",
      "index.html",
      "manifest.webmanifest",
      "portal.html",
      "styles.css",
      "sw.js",
      "extras.js"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon-512.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "Hippolyte Mias (@hipo.reporter)"
}